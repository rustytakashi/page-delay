{
  "manifest_version": 2,
  "name": "Page Load Delay",
  "version": "1.0",
  "description": "Delays loading webpages by 5 seconds",

  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "<all_urls>"
  ],

  "background": {
    "scripts": ["background.js"]
  },

  "browser_action": {
    "default_title": "Page Load Delay"
  },

  "web_accessible_resources": [
    "countdown.html",
    "countdown.js"
  ]
}
